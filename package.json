{
	"name": "@tikoci/tzsp-sniff",
	"version": "0.1.0-next",
	"description": "Receive and decode TZSP packet streams from RouterOS (/tool/sniffer, mangle sniff-tzsp) without root, with output sized for agents",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tikoci/tzsp-sniff.git"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"tzsp-sniff": "dist/cli/bin.js"
	},
	"files": [
		"dist/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=22",
		"bun": ">=1.4.4"
	},
	"scripts": {
		"check": "bun run lint && bun run test && bun run build && bun run test:node && bun run test:node-terminal",
		"lint": "bun run lint:types && bun run lint:code && bun run lint:markdown && bun run lint:words && bun run lint:bun-pin && bun run lint:m2ir && bun run lint:external",
		"lint:types": "tsc -p tsconfig.json && tsc -p tsconfig.src.json",
		"lint:code": "biome check --error-on-warnings .",
		"lint:markdown": "markdownlint-cli2 && cspell lint --no-progress",
		"lint:words": "sed -e '/^#/d' -e 's/ *#.*//' -e '/^$/d' project-words.txt | LC_ALL=C sort -c -f -u",
		"lint:bun-pin": "bun scripts/check-bun-pin.ts",
		"lint:external": "sh scripts/lint-external.sh",
		"lint:m2ir": "bun scripts/m2ir.ts --check",
		"lint:fix": "biome check --write .",
		"test": "bun test test/unit",
		"test:coverage": "bun test --coverage test/unit",
		"test:integration": "TZSP_SNIFF_INTEGRATION=1 bun test test/integration",
		"test:tshark": "TZSP_SNIFF_TSHARK=1 bun test test/tshark",
		"build": "rm -rf dist && bun build src/index.ts src/cli/bin.ts --target node --format esm --outdir dist && tsc -p tsconfig.build.json",
		"test:node": "node test/smoke/node-smoke.mjs",
		"test:node-terminal": "bun test test/node",
		"audit": "bun scripts/audit.ts",
		"m2ir:generate": "bun scripts/m2ir.ts",
		"m2ir:refresh": "bun scripts/m2ir.ts refresh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@tikoci/quickchr": "0.6.0",
		"@types/bun": "1.4.4",
		"@types/node": "^22",
		"cspell": "^10.5.1",
		"markdownlint-cli2": "^0.24.1",
		"typescript": "^7.0.2"
	}
}
