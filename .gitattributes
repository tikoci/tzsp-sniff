# tikoci starting .gitattributes (tikoci-toolchain).

# LF in the repo and in every checkout, so a shell script cloned on Windows
# still runs, and no diff is only line endings.
* text=auto eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Captures are bytes.
*.pcap binary
*.pcapng binary

# Generated: collapsed in GitHub diffs and left out of language stats.
bun.lock linguist-generated=true
